// KinShop — Schéma de base de données
// Boutique WhatsApp-native pour vendeurs RDC

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Store {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  ownerName   String
  whatsapp    String
  description String    @default("")
  city        String    @default("Kinshasa")
  logoEmoji   String    @default("🛍️")
  colorTheme  String    @default("emerald")
  rateFC      Float     @default(2850)
  // Premium Chariow
  isPremium   Boolean   @default(false)
  premiumUntil DateTime?
  chariowEmail String   @default("")
  chariowPhone String   @default("")
  chariowSaleId String  @default("")
  // Statut de modération (console admin)
  status      String    @default("active") // active | suspended
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
  orders      Order[]
  invoices    Invoice[]
  visits      StoreVisit[]
  notifications NotificationLog[]
}

// V3 — KinFacture : factures professionnelles avec QR de paiement mobile money
model Invoice {
  id           String    @id @default(cuid())
  number       String    @unique // KF-XXXXXX
  storeId      String
  store        Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  clientName   String
  clientPhone  String    @default("")
  items        String    @default("[]") // JSON [{desc, qty, unitFC}]
  totalFC      Float     @default(0)
  totalUSD     Float     @default(0)
  note         String    @default("")
  dueDate      String    @default("") // date d'échéance libre (AAAA-MM-JJ)
  status       String    @default("draft") // draft | sent | paid
  paidAt       DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Product {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name      String
  emoji     String   @default("📦")
  imageUrl  String   @default("")
  priceUSD  Float
  category  String   @default("Divers")
  stock     Int      @default(99)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id            String   @id @default(cuid())
  ref           String   @unique
  storeId       String
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customerName  String
  customerPhone String
  zone          String   @default("")
  items         String   @default("[]")
  totalUSD      Float
  totalFC       Float
  paymentMethod String   @default("mpesa")
  // V2 — Paiement mobile money en ligne de la commande
  paymentStatus String   @default("unpaid") // unpaid | pending | paid | failed
  paymentRef    String   @default("") // référence de transaction (agrégateur ou simulation)
  payerPhone    String   @default("") // numéro mobile money qui paie (peut différer du client)
  paidAt        DateTime?
  note          String   @default("")
  status        String   @default("new")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Idempotence des webhooks Chariow (Pulses)
model PulseDelivery {
  id         String   @id @default(cuid())
  deliveryId String   @unique
  event      String
  saleId     String   @default("")
  createdAt  DateTime @default(now())
}

// V2 — Statistiques : visites journalières par boutique (agrégat 1 ligne/jour)
model StoreVisit {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  day       DateTime // minuit UTC du jour concerné
  count     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([storeId, day])
}

// V2 — Notifications commandes par SMS (journal ; simulation tant que le fournisseur est absent)
model NotificationLog {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orderId   String   @default("")
  audience  String   @default("vendor") // vendor | customer
  to        String
  body      String
  status    String   @default("simulated") // simulated | sent | failed
  provider  String   @default("simulation")
  createdAt DateTime @default(now())
}

// Paramètres globaux de la plateforme (console admin)
model PlatformSetting {
  key       String   @id
  value     String   @default("")
  updatedAt DateTime @updatedAt
}

// Journal d'audit des actions administrateur
model AdminAction {
  id        String   @id @default(cuid())
  action    String
  target    String
  detail    String   @default("")
  createdAt DateTime @default(now())
}
