// KinShop — Schéma de base de données
// Boutique WhatsApp-native pour vendeurs RDC

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Store {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  ownerName   String
  whatsapp    String
  description String    @default("")
  city        String    @default("Kinshasa")
  logoEmoji   String    @default("🛍️")
  colorTheme  String    @default("emerald")
  rateFC      Float     @default(2850)
  // Premium Chariow
  isPremium   Boolean   @default(false)
  premiumUntil DateTime?
  chariowEmail String   @default("")
  chariowPhone String   @default("")
  chariowSaleId String  @default("")
  // Statut de modération (console admin)
  status      String    @default("active") // active | suspended
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
  orders      Order[]
}

model Product {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name      String
  emoji     String   @default("📦")
  imageUrl  String   @default("")
  priceUSD  Float
  category  String   @default("Divers")
  stock     Int      @default(99)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id            String   @id @default(cuid())
  ref           String   @unique
  storeId       String
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customerName  String
  customerPhone String
  zone          String   @default("")
  items         String   @default("[]")
  totalUSD      Float
  totalFC       Float
  paymentMethod String   @default("mpesa")
  note          String   @default("")
  status        String   @default("new")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Idempotence des webhooks Chariow (Pulses)
model PulseDelivery {
  id         String   @id @default(cuid())
  deliveryId String   @unique
  event      String
  saleId     String   @default("")
  createdAt  DateTime @default(now())
}

// Paramètres globaux de la plateforme (console admin)
model PlatformSetting {
  key       String   @id
  value     String   @default("")
  updatedAt DateTime @updatedAt
}

// Journal d'audit des actions administrateur
model AdminAction {
  id        String   @id @default(cuid())
  action    String
  target    String
  detail    String   @default("")
  createdAt DateTime @default(now())
}
