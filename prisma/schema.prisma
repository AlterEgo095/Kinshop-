// KinShop — Schéma de base de données
// Boutique WhatsApp-native pour vendeurs RDC

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Store {
  id          String    @id @default(cuid())
  // V10 — Vérification des propriétaires (proportionnelle au risque, gérée admin) : unverified | pending | verified | rejected
  verificationStatus String @default("unverified")
  // P5 — Demande de vérification du propriétaire (anti-spam : cooldown gouvernance)
  verificationRequestedAt DateTime?
  slug        String    @unique
  name        String
  ownerName   String
  whatsapp    String
  // V8 — Propriétaire authentifié (compte utilisateur). Null = boutique orpheline
  // créée avant l'introduction des comptes (lecture publique seule, non éditable).
  ownerId     String?
  owner       User?     @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  description String    @default("")
  city        String    @default("Kinshasa")
  logoEmoji   String    @default("🛍️")
  colorTheme  String    @default("emerald")
  rateFC      Float     @default(2850)
  // Premium Chariow
  isPremium   Boolean   @default(false)
  premiumUntil DateTime?
  chariowEmail String   @default("")
  chariowPhone String   @default("")
  chariowSaleId String  @default("")
  // Statut de modération (console admin)
  status      String    @default("active") // active | suspended
  // V7 — Domaine personnalisé (réservé Premium)
  customDomain   String? @unique // ex. maboutique.cd (null = aucun)
  domainVerified Boolean @default(false) // vérifié par TXT DNS (_kinshop-verify.<domaine>)
  domainToken    String  @default("") // jeton de vérification kinshop-verify=<token>
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
  orders      Order[]
  invoices    Invoice[]
  visits      StoreVisit[]
  notifications NotificationLog[]
  // V6 — Confiance & Croissance
  reviews       Review[]
  coupons       Coupon[]
  deliveryZones DeliveryZone[]
  // V10 — Catalogue hiérarchisé & promotion payante (indépendante de Premium)
  storeCategories StoreCategory[]
  boosts          BoostCampaign[]

  @@index([ownerId])
}

// V8 — Compte utilisateur : chaque boutique appartient à un utilisateur authentifié.
model User {
  id           String    @id @default(cuid())
  email        String    @unique // toujours stocké en minuscules
  passwordHash String // format s1$<salt>$<hash> (scrypt, jamais le mot de passe en clair)
  name         String
  whatsapp     String    @default("")
  role         String    @default("user") // user | admin (réservé)
  // P5 — Gouvernance : suspension de compte (administration) — un compte suspendu
  // perd ses sessions et ne peut plus se connecter tant que la suspension tient.
  status          String    @default("active") // active | suspended
  suspendedAt     DateTime?
  suspendedReason String    @default("")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  stores       Store[]
  sessions     Session[]
  // Mission sécurité 2026-09-15 — récupération de mot de passe
  passwordResetTokens PasswordResetToken[]
  // V10 — Historique client : commandes passées avec ce compte + signalements
  orders       Order[]
  reports      Report[]
}

// V8 — Session opaque : le cookie ne contient qu'un jeton aléatoire, la base
// ne stocke que son SHA-256 (un vol de base ne permet pas de voler les sessions).
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// Mission sécurité 2026-09-15 — Récupération de mot de passe : tokens hashés,
// usage unique, expiration 60 min, révocables. Le token brut (32 octets CSPRNG)
// n'existe QUE dans l'email envoyé — la base ne stocke QUE son SHA-256
// (même contrat que les sessions opaques V8).
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique // SHA-256 du token brut
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime? // consommation atomique (claim updateMany conditionnel)
  revokedAt DateTime? // nouvelle demande ou utilisation d'un autre token
  requestIp String    @default("") // IP de la demande (audit, jamais le token)

  @@index([userId])
  @@index([expiresAt])
}

// V3 — KinFacture : factures professionnelles avec QR de paiement mobile money
// V8 — Abonnement Premium (état réel calculé côté serveur).
// Implémentation actuelle : isPremium + premiumUntil sur Store, activé UNIQUEMENT par
// le webhook Chariow signé (HMAC) ou la console admin. Aucune route API publique ne
// permet d'écrire ces champs. Le modèle Subscription dédié devient utile si plusieurs
// plans/prix coexistent — la matrice des droits est dans src/lib/plans.ts.
model Invoice {
  id           String    @id @default(cuid())
  number       String    @unique // KF-XXXXXX (KinFacture) | INV-YYYY-NNNNNN (facture de commande V10)
  storeId      String
  store        Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  // V10 — Facture émise depuis une commande (source="order") ; null = facture libre KinFacture
  orderId      String?
  order        Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  source       String    @default("manual") // manual | order
  hash         String    @default("") // empreinte d'intégrité (sha256 du contenu canonique)
  version      Int       @default(1)
  relatedInvoiceId String  @default("") // facture rectifiée / avoir → référence de l'originale
  clientName   String
  clientPhone  String    @default("")
  items        String    @default("[]") // JSON [{desc, qty, unitFC}]
  totalFC      Float     @default(0)
  totalUSD     Float     @default(0)
  note         String    @default("")
  dueDate      String    @default("") // date d'échéance libre (AAAA-MM-JJ)
  status       String    @default("draft") // draft | sent | paid | cancelled | credited (V10)
  paidAt       DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Product {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name      String
  emoji     String   @default("📦")
  imageUrl  String   @default("") // image principale (rétrocompat, = images[0])
  images    String   @default("[]") // V4 — galerie multi-photos (JSON string[])
  // Mission Premium — présentation commerciale riche (fonctionnalités abonnés actifs)
  description String @default("") // description mise en forme (paragraphes, « - » puces, **gras**)
  specs       String @default("[]") // caractéristiques structurées (JSON [{label,value}] : dimensions, avantages, variantes…)
  priceUSD  Float
  category  String   @default("Divers") // V10 — legacy (libellé libre, gardé pour rétrocompat)
  // V10 — Catégorie de boutique (rattachée éventuellement à une catégorie globale)
  storeCategoryId String?
  storeCategory   StoreCategory? @relation(fields: [storeCategoryId], references: [id], onDelete: SetNull)
  stock     Int      @default(99)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeCategoryId])
}

// V10 — Catégories GLOBALES du marketplace (créées par le Super Admin)
model GlobalCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  icon      String   @default("📦")
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  storeCategories StoreCategory[]
}

// V10 — Catégories PROPRES À UNE BOUTIQUE (créées par le propriétaire)
model StoreCategory {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name      String
  slug      String
  // Rattachement optionnel à une catégorie globale (navigation marketplace)
  globalCategoryId String?
  globalCategory   GlobalCategory? @relation(fields: [globalCategoryId], references: [id], onDelete: SetNull)
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  products  Product[]

  @@unique([storeId, slug])
  @@index([storeId])
}

model Order {
  id            String   @id @default(cuid())
  ref           String   @unique
  storeId       String
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  // V10 — Compte client (null = commande invité legacy pré-V10). Commander exige désormais un compte.
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName  String
  customerPhone String
  zone          String   @default("")
  items         String   @default("[]")
  totalUSD      Float
  totalFC       Float
  paymentMethod String   @default("mpesa")
  // V2 — Paiement mobile money en ligne de la commande
  // V10 — vocabulaire étendu : unpaid | pending | cash_pending | paid | failed | refunded
  paymentStatus String   @default("unpaid")
  paymentRef    String   @default("") // référence de transaction (agrégateur ou simulation)
  payerPhone    String   @default("") // numéro mobile money qui paie (peut différer du client)
  paidAt        DateTime?
  // V10 — Dimension LIVRAISON indépendante du statut commande et du paiement :
  // not_assigned | assigned | picked_up | in_transit | out_for_delivery | delivered | failed | returned
  deliveryStatus   String @default("not_assigned")
  deliveryAttempts Int    @default(0) // tentatives (relances après échec)
  deliveryReason   String @default("") // dernier motif structuré (échec/retour)
  deliveryAddress  String @default("") // adresse de livraison libre (complète la zone)
  // V6 — Récap commerce détaillé (sous-total − remise + livraison)
  couponCode    String   @default("") // code promo appliqué ("" = aucun)
  discountUSD   Float    @default(0) // remise accordée
  deliveryZone  String   @default("") // nom de la zone de livraison
  deliveryFeeFC Float    @default(0) // frais de livraison en FC
  note          String   @default("")
  status        String   @default("new")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  // V10 — Traçabilité (immuable) + remboursements + factures de commande
  events        OrderEvent[]
  refunds       Refund[]
  invoices      Invoice[]

  @@index([userId])
  @@index([storeId, status])
}

// V10 — Historique immuable d'une commande : chaque événement critique laisse une trace
// (qui, quand, de quoi vers quoi, pourquoi). Aucune route ne modifie ni ne supprime une entrée.
model OrderEvent {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type       String // created | status_changed | payment_selected | payment_confirmed | payment_failed | delivery_updated | delivery_failed | delivery_retry | delivery_returned | refund_requested | refund_approved | refund_rejected | refund_executed | invoice_generated | note
  actorType  String   @default("system") // customer | owner | admin | system
  actorId    String   @default("")
  actorLabel String   @default("")
  oldValue   String   @default("")
  newValue   String   @default("")
  reason     String   @default("")
  createdAt  DateTime @default(now())

  @@index([orderId, createdAt])
}

// V10 — Remboursement (litige/erreur) : demandé par client ou vendeur, validé et exécuté par l'admin.
model Refund {
  id              String   @id @default(cuid())
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amountUSD       Float
  method          String   @default("mobile_money") // mobile_money | cash | other
  reference       String   @default("") // référence d'exécution (opérateur/reçu)
  reason          String   @default("")
  status          String   @default("requested") // requested | approved | rejected | executed
  requestedByType String   @default("customer") // customer | owner | admin
  requestedById   String   @default("")
  handledBy       String   @default("")
  proofNote       String   @default("") // preuve (note libre, référence de capture)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([orderId])
}

// V10 — Signalement (boutique/produit/commande/utilisateur) — workflow de modération.
model Report {
  id             String   @id @default(cuid())
  targetType     String // store | product | order | user
  targetId       String
  targetLabel    String   @default("") // copie lisible résiliente à la suppression
  reporterId     String?
  reporter       User?    @relation(fields: [reporterId], references: [id], onDelete: SetNull)
  reporterLabel  String   @default("")
  reason         String   @default("autre") // arnaque | produit_non_conforme | livraison | comportement | autre
  details        String   @default("")
  status         String   @default("open") // open | under_review | action_required | resolved | dismissed
  resolutionNote String   @default("")
  handledBy      String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([targetType, targetId])
  @@index([status])
}

// V10 — Promotion payante (Boost) : ACHÈTE DE LA VISIBILITÉ — indépendant de l'abonnement Premium
// (qui donne des fonctionnalités). Une campagne active met la boutique en avant sur l'accueil,
// clairement identifiée « Sponsorisé ».
model BoostCampaign {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  placement   String   @default("home_featured")
  startAt     DateTime
  endAt       DateTime
  costUSD     Float    @default(0)
  status      String   @default("pending_payment") // pending_payment | active | ended | rejected
  paymentRef  String   @default("")
  impressions Int      @default(0)
  clicks      Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([storeId])
  @@index([status, endAt])
}

// V10 — Compteur atomique (numérotation séquentielle CMD-2026-000001 / INV-2026-000001)
model Counter {
  key   String @id
  value Int    @default(0)
}

// V10 — Déduplication des visites (hash slug|ip|ua|jour) pour estimer les visiteurs uniques
model VisitDedup {
  id        String   @id @default(cuid())
  key       String   @unique
  createdAt DateTime @default(now())
}

// Idempotence des webhooks Chariow (Pulses)
model PulseDelivery {
  id         String   @id @default(cuid())
  deliveryId String   @unique
  event      String
  saleId     String   @default("")
  createdAt  DateTime @default(now())
}

// V2 — Statistiques : visites journalières par boutique (agrégat 1 ligne/jour)
model StoreVisit {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  day       DateTime // minuit UTC du jour concerné
  count     Int      @default(0) // pages vues boutique
  unique    Int      @default(0) // V10 — visiteurs uniques estimés (dédup slug|ip|ua|jour)
  updatedAt DateTime @updatedAt

  @@unique([storeId, day])
}

// V2 — Notifications commandes par SMS (journal ; simulation tant que le fournisseur est absent)
model NotificationLog {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orderId   String   @default("")
  audience  String   @default("vendor") // vendor | customer
  to        String
  body      String
  status    String   @default("simulated") // simulated | sent | failed
  provider  String   @default("simulation")
  createdAt DateTime @default(now())
}

// V6 — Avis clients laissés sur une boutique (modérés par le vendeur)
model Review {
  id         String   @id @default(cuid())
  storeId    String
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orderId    String   @default("") // commande liée (badge « Commande vérifiée »)
  authorName String
  rating     Int      // 1..5 étoiles
  comment    String   @default("")
  hidden     Boolean  @default(false) // modération vendeur (masquer/restaurer)
  createdAt  DateTime @default(now())
}

// V6 — Code promo créé par le vendeur (valide côté serveur au checkout)
model Coupon {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  code        String   // majuscules, unique par boutique
  type        String   @default("percent") // percent | fixed
  value       Float    // pourcentage (1..90) ou montant fixe USD
  minTotalUSD Float    @default(0) // panier minimum pour être applicable
  maxUses     Int      @default(0) // 0 = illimité
  uses        Int      @default(0) // compteur d'utilisations
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([storeId, code])
}

// V6 — Zone de livraison tarifée (quartiers/communes desservies)
model DeliveryZone {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name      String
  feeFC     Float    @default(0) // frais de livraison en FC (0 = gratuit)
  // V10 — Type d'option de livraison + délai estimé affiché au client
  // standard | express | pickup | local | national
  kind      String   @default("standard")
  etaLabel  String   @default("") // ex. « 24-48 h », « le jour même »
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([storeId, name])
}

// Paramètres globaux de la plateforme (console admin)
model PlatformSetting {
  key       String   @id
  value     String   @default("")
  updatedAt DateTime @updatedAt
}

// Journal d'audit global (V10 : acteurs admin/user/owner/customer/system)
model AdminAction {
  id         String   @id @default(cuid())
  action     String
  target     String
  detail     String   @default("")
  actorType  String   @default("admin") // admin | user | owner | customer | system
  actorId    String   @default("")
  entityType String   @default("") // store | product | order | invoice | report | refund | boost | config | auth
  entityId   String   @default("")
  // P5 — Chaîne d'intégrité du journal : chaque entrée scelle la précédente
  // (hash = sha256(prevHash + payload)). Entrées héritées pré-P5 : hash vide.
  prevHash  String   @default("")
  hash      String   @default("")
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
}
