// KinShop — Schéma de base de données
// Boutique WhatsApp-native pour vendeurs RDC

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Store {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  ownerName   String
  whatsapp    String
  // V8 — Propriétaire authentifié (compte utilisateur). Null = boutique orpheline
  // créée avant l'introduction des comptes (lecture publique seule, non éditable).
  ownerId     String?
  owner       User?     @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  description String    @default("")
  city        String    @default("Kinshasa")
  logoEmoji   String    @default("🛍️")
  colorTheme  String    @default("emerald")
  rateFC      Float     @default(2850)
  // Premium Chariow
  isPremium   Boolean   @default(false)
  premiumUntil DateTime?
  chariowEmail String   @default("")
  chariowPhone String   @default("")
  chariowSaleId String  @default("")
  // Statut de modération (console admin)
  status      String    @default("active") // active | suspended
  // V7 — Domaine personnalisé (réservé Premium)
  customDomain   String? @unique // ex. maboutique.cd (null = aucun)
  domainVerified Boolean @default(false) // vérifié par TXT DNS (_kinshop-verify.<domaine>)
  domainToken    String  @default("") // jeton de vérification kinshop-verify=<token>
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
  orders      Order[]
  invoices    Invoice[]
  visits      StoreVisit[]
  notifications NotificationLog[]
  // V6 — Confiance & Croissance
  reviews       Review[]
  coupons       Coupon[]
  deliveryZones DeliveryZone[]

  @@index([ownerId])
}

// V8 — Compte utilisateur : chaque boutique appartient à un utilisateur authentifié.
model User {
  id           String    @id @default(cuid())
  email        String    @unique // toujours stocké en minuscules
  passwordHash String // format s1$<salt>$<hash> (scrypt, jamais le mot de passe en clair)
  name         String
  whatsapp     String    @default("")
  role         String    @default("user") // user | admin (réservé)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  stores       Store[]
  sessions     Session[]
}

// V8 — Session opaque : le cookie ne contient qu'un jeton aléatoire, la base
// ne stocke que son SHA-256 (un vol de base ne permet pas de voler les sessions).
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// V3 — KinFacture : factures professionnelles avec QR de paiement mobile money
// V8 — Abonnement Premium (état réel calculé côté serveur).
// Implémentation actuelle : isPremium + premiumUntil sur Store, activé UNIQUEMENT par
// le webhook Chariow signé (HMAC) ou la console admin. Aucune route API publique ne
// permet d'écrire ces champs. Le modèle Subscription dédié devient utile si plusieurs
// plans/prix coexistent — la matrice des droits est dans src/lib/plans.ts.
model Invoice {
  id           String    @id @default(cuid())
  number       String    @unique // KF-XXXXXX
  storeId      String
  store        Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  clientName   String
  clientPhone  String    @default("")
  items        String    @default("[]") // JSON [{desc, qty, unitFC}]
  totalFC      Float     @default(0)
  totalUSD     Float     @default(0)
  note         String    @default("")
  dueDate      String    @default("") // date d'échéance libre (AAAA-MM-JJ)
  status       String    @default("draft") // draft | sent | paid
  paidAt       DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Product {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name      String
  emoji     String   @default("📦")
  imageUrl  String   @default("") // image principale (rétrocompat, = images[0])
  images    String   @default("[]") // V4 — galerie multi-photos (JSON string[])
  priceUSD  Float
  category  String   @default("Divers")
  stock     Int      @default(99)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id            String   @id @default(cuid())
  ref           String   @unique
  storeId       String
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customerName  String
  customerPhone String
  zone          String   @default("")
  items         String   @default("[]")
  totalUSD      Float
  totalFC       Float
  paymentMethod String   @default("mpesa")
  // V2 — Paiement mobile money en ligne de la commande
  paymentStatus String   @default("unpaid") // unpaid | pending | paid | failed
  paymentRef    String   @default("") // référence de transaction (agrégateur ou simulation)
  payerPhone    String   @default("") // numéro mobile money qui paie (peut différer du client)
  paidAt        DateTime?
  // V6 — Récap commerce détaillé (sous-total − remise + livraison)
  couponCode    String   @default("") // code promo appliqué ("" = aucun)
  discountUSD   Float    @default(0) // remise accordée
  deliveryZone  String   @default("") // nom de la zone de livraison
  deliveryFeeFC Float    @default(0) // frais de livraison en FC
  note          String   @default("")
  status        String   @default("new")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Idempotence des webhooks Chariow (Pulses)
model PulseDelivery {
  id         String   @id @default(cuid())
  deliveryId String   @unique
  event      String
  saleId     String   @default("")
  createdAt  DateTime @default(now())
}

// V2 — Statistiques : visites journalières par boutique (agrégat 1 ligne/jour)
model StoreVisit {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  day       DateTime // minuit UTC du jour concerné
  count     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([storeId, day])
}

// V2 — Notifications commandes par SMS (journal ; simulation tant que le fournisseur est absent)
model NotificationLog {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orderId   String   @default("")
  audience  String   @default("vendor") // vendor | customer
  to        String
  body      String
  status    String   @default("simulated") // simulated | sent | failed
  provider  String   @default("simulation")
  createdAt DateTime @default(now())
}

// V6 — Avis clients laissés sur une boutique (modérés par le vendeur)
model Review {
  id         String   @id @default(cuid())
  storeId    String
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orderId    String   @default("") // commande liée (badge « Commande vérifiée »)
  authorName String
  rating     Int      // 1..5 étoiles
  comment    String   @default("")
  hidden     Boolean  @default(false) // modération vendeur (masquer/restaurer)
  createdAt  DateTime @default(now())
}

// V6 — Code promo créé par le vendeur (valide côté serveur au checkout)
model Coupon {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  code        String   // majuscules, unique par boutique
  type        String   @default("percent") // percent | fixed
  value       Float    // pourcentage (1..90) ou montant fixe USD
  minTotalUSD Float    @default(0) // panier minimum pour être applicable
  maxUses     Int      @default(0) // 0 = illimité
  uses        Int      @default(0) // compteur d'utilisations
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([storeId, code])
}

// V6 — Zone de livraison tarifée (quartiers/communes desservies)
model DeliveryZone {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name      String
  feeFC     Float    @default(0) // frais de livraison en FC (0 = gratuit)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([storeId, name])
}

// Paramètres globaux de la plateforme (console admin)
model PlatformSetting {
  key       String   @id
  value     String   @default("")
  updatedAt DateTime @updatedAt
}

// Journal d'audit des actions administrateur
model AdminAction {
  id        String   @id @default(cuid())
  action    String
  target    String
  detail    String   @default("")
  createdAt DateTime @default(now())
}
