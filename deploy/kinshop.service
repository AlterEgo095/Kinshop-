# KinShop — Service systemd
# Installation :
#   sudo cp deploy/kinshop.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now kinshop

[Unit]
Description=KinShop — plateforme boutiques WhatsApp (Next.js standalone)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/kinshop
# Le .env du projet fournit DATABASE_URL et ADMIN_PIN
EnvironmentFile=/opt/kinshop/.env
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOSTNAME=127.0.0.1
ExecStart=/root/.bun/bin/bun .next/standalone/server.js
Restart=always
RestartSec=3
StandardOutput=append:/var/log/kinshop.log
StandardError=append:/var/log/kinshop.err.log

# Durcissement léger
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
