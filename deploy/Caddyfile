# KinShop — Configuration Caddy de production
# Serveur : kinshop.aenews.digital (95.111.226.63)
#
# Installation :
#   sudo cp deploy/Caddyfile /etc/caddy/Caddyfile
#   sudo systemctl reload caddy
#
# HTTPS est émis automatiquement par Let's Encrypt :
#  - pour kinshop.aenews.digital (déjà en DNS, « DNS uniquement » → parfait)
#  - pour chaque domaine vendeur vérifié, à la demande (on_demand_tls),
#    autorisé uniquement si /api/domain-check répond 200 (domaine relié
#    à une boutique KinShop vérifiée) → impossible d'épuiser Let's Encrypt.

{
	email admin@aenews.digital
	on_demand_tls {
		ask http://127.0.0.1:3000/api/domain-check
	}
}

# ── Plateforme principale ─────────────────────────────────────────
kinshop.aenews.digital {
	reverse_proxy 127.0.0.1:3000
}

# ── Domaines personnalisés des boutiques (TLS à la demande) ───────
# Catch-all HTTPS : tout domaine non déclaré ci-dessus obtient un
# certificat uniquement après validation par l'endpoint ask ci-dessus.
https:// {
	reverse_proxy 127.0.0.1:3000
}
